# Required. Without it the app has no contract to read and says so.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x8d57088F8054c715DD0b0E9D396F61CA1826d1f9

# Optional — defaults to StudioNet's own RPC. The chain id is NOT
# configurable: it is read from the same chain object the GenLayer client
# is built with, so the wallet and the client cannot disagree about it.
# NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
