# Copy to .env before running the LIVE suite:
#     gltest tests/integration -v -s --network studionet
#
# The direct suite needs none of this — `pytest tests/direct/` runs
# offline with no keys and no network.
#
# One funded StudioNet account. Never commit the filled-in .env.
ATTESTIA_KEY=0x<private key of a funded StudioNet account>

# Set to 1 to skip the slow live-panel rounds and run only the fast
# on-chain checks. NOTE: gltest loads this file with override=True, so a
# value here beats one exported in your shell.
ATTESTIA_SKIP_PANEL=0
